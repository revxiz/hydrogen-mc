{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${version}",
	"name": "${mod_name}",
	"description": "${mod_description}",
	"authors": [
		"${mod_authors}"
	],
	"contact": {
		"sources": "${mod_source}",
		"issues": "${mod_issues}"
	},
	"license": "${mod_license}",
	"icon": "assets/hydrogen/icon.png",
	"environment": "*",
	"entrypoints": {
		"preLaunch": [
			"dev.hydrogen.mc.loader.HydrogenFabric"
		]
	},
	"mixins": [
		"hydrogen.mixins.json",
		{
			"config": "hydrogen.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": "${fabric_loader_range}",
		"minecraft": "${fabric_mc_range}",
		"java": ">=${java_version}"
	}
}
